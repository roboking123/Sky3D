// 體積雲合成 — 共享本體（被 .glsl 與 .msaa.glsl 包含）
// 把八面體預計算貼圖合成到螢幕色彩緩衝，支援時序累積、大氣散射、深度遮擋、MSAA
//
// MSAA：雲計算逐像素，深度遮擋逐 MSAA 樣本。MSAA 開啟時必須寫進 MSAA color
// 緩衝（image2DMS）而非 resolved，否則後續 pass 用 MSAA 緩衝會看不到雲。

#define PI 3.141592653589793

#ifndef MSAA_ENABLED
#define MSAA_ENABLED 0
#endif

#if MSAA_ENABLED
	#define ScreenImageType image2DMS
	#define DepthSamplerType sampler2DMS
	#define DEPTH_SAMPLE_COUNT textureSamples(depth_image)
	#define FETCH_DEPTH(coord, s) texelFetch(depth_image, coord, s).r
	#define LOAD_SCREEN(coord, s) imageLoad(screen_image, coord, s)
	#define STORE_SCREEN(coord, s, c) imageStore(screen_image, coord, s, c)
#else
	#define ScreenImageType image2D
	#define DepthSamplerType sampler2D
	#define DEPTH_SAMPLE_COUNT 1
	#define FETCH_DEPTH(coord, s) texelFetch(depth_image, coord, 0).r
	#define LOAD_SCREEN(coord, s) imageLoad(screen_image, coord)
	#define STORE_SCREEN(coord, s, c) imageStore(screen_image, coord, c)
#endif

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// binding 0: 螢幕色彩（讀寫；MSAA 時為 image2DMS）
layout(rgba16f, binding = 0) uniform ScreenImageType screen_image;

// binding 1: 深度（MSAA 時為 sampler2DMS）
layout(binding = 1) uniform DepthSamplerType depth_image;

// binding 2-3: 八面體雲貼圖（blend_from / blend_to）
layout(binding = 2) uniform sampler2D blend_from_texture;
layout(binding = 3) uniform sampler2D blend_to_texture;

// binding 4: 通用資料
layout(binding = 4, std140) uniform GenericDataBuffer {
	vec2 screen_size;          // 0-1
	float blend_amount;        // 2
	float is_accumulation_a;   // 3
	vec3 sun_direction;        // 4-6
	float atmospheric_density; // 7
	vec3 moon_direction;       // 8-10
	float blur_power;          // 11
	vec2 color_correction;     // 12-13
	float blur_quality;        // 14
	float accumulation_decay;  // 15
	vec3 atmosphere_color;     // 16-18
	float resolution_scale;    // 19 — 1=原生, 2=半, 4=四分之一, 8=八分之一（MSAA 時強制 1）
	vec4 _reserved[3];         // 20-31
} params;

// binding 5-6: 時序累積貼圖（乒乓，永遠非 MSAA，逐像素）
layout(rgba16f, binding = 5) uniform image2D accum_color_a;
layout(rgba16f, binding = 6) uniform image2D accum_color_b;

// binding 9: 相機矩陣（自建 UBO，理由見 VolumetricCloudEffect._update_camera_data）
layout(binding = 9, std140) uniform CameraData {
	mat4 inv_projection;
	mat4 inv_view;
	mat4 prev_view;
	mat4 prev_projection;
	float z_far;
	float z_near;
	float _cpad0;
	float _cpad1;
} camera;


// ============================================================================
// 八面體映射
// ============================================================================

vec2 oct_wrap(vec2 v) {
	vec2 signVal;
	signVal.x = v.x >= 0.0 ? 1.0 : -1.0;
	signVal.y = v.y >= 0.0 ? 1.0 : -1.0;
	return (1.0 - abs(v.yx)) * signVal;
}

vec2 vec3_to_oct(vec3 e) {
	e /= abs(e.x) + abs(e.y) + abs(e.z);
	e.xy = e.z >= 0.0 ? e.xy : oct_wrap(e.xy);
	vec2 n;
	n.y = e.y * 0.5 + 0.5;
	n.x = e.x * 0.5 + n.y;
	n.y = e.x * -0.5 + n.y;
	return n;
}

// ============================================================================
// 色調映射 / 大氣 / 模糊
// ============================================================================

vec3 apply_photo_tonemap(vec3 color, float exposure, float level) {
	color.rgb *= exposure;
	return mix(color.rgb, 1.0 - exp(-color.rgb), level);
}

float henyey_greenstein(float cos_theta, float g) {
	const float k = 0.0795774715459;
	return k * (1.0 - g * g) / pow(1.0 + g * g - 2.0 * g * cos_theta, 1.5);
}

vec3 sample_atmospherics(vec3 ray_dir, vec3 sun_dir, float distance_traveled, float density, float atmo_density) {
	if (atmo_density <= 0.001 || distance_traveled <= 0.0) return vec3(0.0);
	const vec3 RayleighCoef = vec3(5.5e-6, 13.0e-6, 22.4e-6);
	const float MieCoef = 21e-6;
	const float MieG = 0.758;
	float mu = dot(ray_dir, sun_dir);
	float pRlh = 3.0 / (16.0 * PI) * (1.0 + mu * mu);
	float gg = MieG * MieG;
	float pMie = 3.0 / (8.0 * PI) * ((1.0 - gg) * (mu * mu + 1.0)) / (pow(1.0 + gg - 2.0 * mu * MieG, 1.5) * (2.0 + gg));
	float optical_depth = distance_traveled * atmo_density * 0.0001;
	vec3 scatter = (pRlh * RayleighCoef + pMie * MieCoef) * optical_depth * (1.0 - density);
	return scatter * params.atmosphere_color * 22.0;
}

vec4 radial_blur(vec4 start_color, ivec2 center_uv, ivec2 img_size, float blur_h, float blur_v, float quality) {
	float pi2 = 6.28318530718;
	float count = 1.0;
	vec4 result = start_color;
	for (float d = 0.0; d < pi2; d += pi2 / (quality * 4.0)) {
		for (float i = 1.0 / quality; i <= 1.0; i += 1.0 / quality) {
			ivec2 offset = ivec2(int(cos(d) * blur_h * i), int(sin(d) * blur_v * i));
			ivec2 sample_uv = clamp(center_uv + offset, ivec2(0), img_size - ivec2(1));
			result += imageLoad(accum_color_a, sample_uv);
			count += 1.0;
		}
	}
	return result / count;
}

// 把 raw depth 線性化成視距
float linearize_depth(float depth_raw, vec2 ndc_uv) {
	vec4 v = camera.inv_projection * vec4(ndc_uv * 2.0 - 1.0, depth_raw, 1.0);
	v.xyz /= v.w;
	return length(v.xyz);
}

// 雲遮擋：雲在天穹殼（~6000km），地表幾何（數 km）一律在雲前方，所以非天空像素
// 完全遮擋雲、天空像素顯示雲。二元判定；幾何剪影硬邊由 per-sample MSAA 抗鋸齒。
// 八面體模型無深度，不需要也無法做距離軟過渡。
float occlusion_fade(bool is_sky) {
	return is_sky ? 1.0 : 0.0;
}

// ============================================================================
// 主程式
// ============================================================================

void main() {
	ivec2 size = ivec2(params.screen_size);
	// MSAA 時強制原生解析度（per-sample 合成需要全解析度）
#if MSAA_ENABLED
	int res_scale_i = 1;
#else
	int res_scale_i = max(1, int(params.resolution_scale));
#endif
	ivec2 work_size = (size + ivec2(res_scale_i - 1)) / ivec2(res_scale_i);
	ivec2 uv = ivec2(gl_GlobalInvocationID.xy);

	if (uv.x >= work_size.x || uv.y >= work_size.y) {
		return;
	}

	vec2 screen_uv = (vec2(uv) * float(res_scale_i) + 0.5 * float(res_scale_i)) / vec2(size);

	// 代表深度（per-pixel：給 ray 方向重建與大氣距離用，取 sample 0）
	ivec2 rep_pixel = ivec2(screen_uv * vec2(size));
	float depth_raw = FETCH_DEPTH(rep_pixel, 0);

	vec4 view = camera.inv_projection * vec4(screen_uv * 2.0 - 1.0, depth_raw, 1.0);
	view.xyz /= view.w;
	float linear_depth = length(view.xyz);
	bool is_sky = linear_depth >= camera.z_far * 0.99;
	if (is_sky) {
		linear_depth *= 100.0;
	}

	// 重建世界空間視線方向
	vec4 clip_pos = vec4(screen_uv * 2.0 - 1.0, 0.0, 1.0);
	vec4 view_pos = camera.inv_projection * clip_pos;
	view_pos.xyz /= view_pos.w;
	vec3 rd_view = normalize(view_pos.xyz);
	vec3 ray_dir = normalize(mat3(camera.inv_view) * rd_view);

	if (ray_dir.y <= 0.0) {
		return;
	}

	// 八面體取樣
	vec3 norm = ray_dir;
	norm.y = max(0.001, norm.y);
	norm = normalize(norm);
	vec2 oct_uv = vec3_to_oct(norm.xzy);
	vec4 cloud_from = texture(blend_from_texture, oct_uv);
	vec4 cloud_to = texture(blend_to_texture, oct_uv);
	vec4 clouds = mix(cloud_from, cloud_to, params.blend_amount);
	clouds.rgb = apply_photo_tonemap(clouds.rgb, params.color_correction.y, params.color_correction.x);

	// 地平線淡出（per-pixel）。深度遮擋移到最後 per-sample，不進時序累積。
	float horizon_fade = smoothstep(0.0, 0.05, ray_dir.y);
	float cloud_alpha = clamp(clouds.a * horizon_fade, 0.0, 1.0);

	// 時序重投影累積
	vec4 current_cloud = vec4(clouds.rgb, cloud_alpha);
	vec4 accum_result = current_cloud;
	float decay = params.accumulation_decay;
	if (decay > 0.001) {
		// 雲在天穹殼，世界點 = 視距方向上的點；靜態世界點重投影只受相機旋轉影響
		vec3 world_pos = mat3(camera.inv_view) * view.xyz + camera.inv_view[3].xyz;
		vec4 prev_view_pos = camera.prev_view * vec4(world_pos, 1.0);
		vec4 prev_clip = camera.prev_projection * prev_view_pos;
		vec2 prev_screen = (prev_clip.xy / prev_clip.w) * 0.5 + 0.5;
		ivec2 prev_uv = uv + ivec2((prev_screen - screen_uv) * vec2(size));
		ivec2 clamped_prev = clamp(prev_uv, ivec2(0), size - ivec2(1));
		bool reject = (clamped_prev != prev_uv) || (prev_clip.z > 0.0);

		vec4 prev_color;
		if (params.is_accumulation_a > 0.5) {
			prev_color = reject ? current_cloud : imageLoad(accum_color_a, clamped_prev);
		} else {
			prev_color = reject ? current_cloud : imageLoad(accum_color_b, clamped_prev);
		}
		accum_result = prev_color * decay + current_cloud * (1.0 - decay);
	}

	// 寫累積緩衝（乒乓）
	if (params.is_accumulation_a > 0.5) {
		imageStore(accum_color_b, uv, accum_result);
	} else {
		imageStore(accum_color_a, uv, accum_result);
	}

	// Bicubic 徑向模糊
	if (params.blur_power > 0.0 && params.blur_quality > 0.0) {
		accum_result = radial_blur(accum_result, uv, size, params.blur_power, params.blur_power, params.blur_quality);
	}

	// 大氣散射 + 最終雲色
	vec3 atmo = sample_atmospherics(ray_dir, params.sun_direction, linear_depth, accum_result.a, params.atmospheric_density);
	vec3 blended_cloud = accum_result.rgb + atmo;
	float cloud_coverage = accum_result.a; // 不含深度遮擋

	// 合成到螢幕：per-pixel block（res_scale）× per-sample（MSAA）逐樣本深度遮擋
	int nsamples = DEPTH_SAMPLE_COUNT;
	for (int dy = 0; dy < res_scale_i; dy++) {
		for (int dx = 0; dx < res_scale_i; dx++) {
			ivec2 write_uv = uv * res_scale_i + ivec2(dx, dy);
			if (write_uv.x >= size.x || write_uv.y >= size.y) continue;
			vec2 wuv_ndc = (vec2(write_uv) + 0.5) / vec2(size);

			for (int s = 0; s < nsamples; s++) {
				float sd = FETCH_DEPTH(write_uv, s);
				float ld = linearize_depth(sd, wuv_ndc);
				bool ssky = ld >= camera.z_far * 0.99;
				float a = clamp(cloud_coverage * occlusion_fade(ssky), 0.0, 1.0);

				vec4 sc = LOAD_SCREEN(write_uv, s);
				vec3 fc = mix(sc.rgb, blended_cloud, a);
				STORE_SCREEN(write_uv, s, vec4(fc, sc.a));
			}
		}
	}
}
